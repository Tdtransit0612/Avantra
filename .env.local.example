# ─────────────────────────────────────────────────────────────────────────────
# Avantra Carrier Services — environment variables
# Copy to .env.local and fill in. NEVER commit .env.local.
#
# Avantra has its OWN Supabase project / GitHub repo / Vercel project / domain.
# Do NOT reuse any Top Dawg or Cryolane credentials here — the whole point of a
# separate project is that a leak or a bad migration can't reach the other two.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (core backend) ──────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Cron / agents ────────────────────────────────────────────────────────────
# Required for Vercel cron auth (compliance watchdog, AR chaser). Without it,
# crons return 401. Generate a long random string: openssl rand -hex 32
CRON_SECRET=
# Claude API — optional, for rate-con parsing / load-board intake
ANTHROPIC_API_KEY=

# ── Email (Resend) ───────────────────────────────────────────────────────────
# Sends broker invoices, fee statements, compliance-expiry warnings, AR chasers.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ── Maps (lane geocoding + address autocomplete) ─────────────────────────────
# Browser key (referrer-restricted): Maps JS + Places autocomplete
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
# Server key (unrestricted): Distance Matrix for lane mileage
GOOGLE_MAPS_API_KEY=

# ── Public load tracking ─────────────────────────────────────────────────────
# Base URL for the anonymous /track/<token> page (defaults to same-origin)
NEXT_PUBLIC_TRACK_BASE_URL=

# ── FMCSA authority lookup (free) ────────────────────────────────────────────
# QCMobile / SAFER web key — request at https://mobile.fmcsa.dot.gov/QCDevsite/
# Used to verify a client carrier's operating authority and to vet brokers.
FMCSA_WEBKEY=

# ── Remit-to fallbacks for Avantra's own fee statements ──────────────────────
# Normally set in-app under Settings → Billing & Remit; these are env fallbacks.
# NOTE: these are AVANTRA's banking details, used only on client fee statements.
# Broker invoices always remit to the CLIENT carrier or their factor.
INVOICE_CHECK_PAYEE=
INVOICE_REMIT_ADDRESS=
INVOICE_ACH_BANK=
INVOICE_ACH_ROUTING=
INVOICE_ACH_ACCOUNT=
INVOICE_ACH_ACCOUNT_NAME=
INVOICE_PAYMENT_TERMS=
